{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "CrmDb": "Data Source=crm.db"
  },
  "Jwt": {
    "Issuer": "CrmApi",
    "Audience": "CrmClients",
    "SecretKey": "super-secret-key-that-is-at-least-32-chars!",
    "ExpiryInMinutes": 60,
    "RefreshTokenDays": 7
  }
}