@HostAddress = http://localhost:5059

# ─────────────────────────────────────────────────────────
# AUTH
# ─────────────────────────────────────────────────────────

### Register
POST {{HostAddress}}/api/auth/register
Content-Type: application/json

{
  "firstName": "Anna",
  "lastName":  "Kowalska",
  "email":     "annaa@crm.pl",
  "password":  "Secret@99",
  "department": "Sales"
}

### Login
POST {{HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "annaa@crm.pl",
  "password": "Secret@99"
}

###

@accessToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..60trvtUY_PVsli2Xj3yM4KKE4zbRWZ4sf4cUMLBTR0o
@refreshToken = CDreFdj91En5xWGwry7n1lmx9FOsQeWa+ofUonT28gJmLcHIcnivHqZYmpHCmQWs7uvwrBcbX5pJrUAS+FthUA==

### Refresh Access Token
POST {{HostAddress}}/api/auth/refresh
Content-Type: application/json

{
  "accessToken": "{{accessToken}}",
  "refreshToken": "{{refreshToken}}"
}

###

### Revoke Refresh Token
POST {{HostAddress}}/api/auth/revoke
Authorization: Bearer {{accessToken}}
Content-Type: application/json

"{{refreshToken}}"

###

### Get Current User
GET {{HostAddress}}/api/auth/me
Authorization: Bearer {{accessToken}}
Accept: application/json

###

# ─────────────────────────────────────────────────────────
# CONTACTS
# ─────────────────────────────────────────────────────────

### Get Contacts
GET {{HostAddress}}/api/contacts?page=1&size=10
Authorization: Bearer {{accessToken}}
Accept: application/json

###

@contactId = 00000000-0000-0000-0000-000000000000

### Get Contact Notes
GET {{HostAddress}}/api/contacts/{{contactId}}/notes
Authorization: Bearer {{accessToken}}
Accept: application/json

###

### Add Note To Contact
POST {{HostAddress}}/api/contacts/{{contactId}}/notes
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "content": "New note",
  "createdBy": "admin"
}

###

# Replace with real note ID
@noteId = 00000000-0000-0000-0000-000000000000

### Delete Note
DELETE {{HostAddress}}/api/contacts/{{contactId}}/notes/{{noteId}}
Authorization: Bearer {{accessToken}}

###

# ─────────────────────────────────────────────────────────
# ERROR TESTS
# ─────────────────────────────────────────────────────────

### Test error - non-existing contact
POST {{HostAddress}}/api/contacts/99999999-9999-9999-9999-999999999999/notes
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "content": "This should return 404"
}

